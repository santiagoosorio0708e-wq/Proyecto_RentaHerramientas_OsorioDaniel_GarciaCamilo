              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Correo y documento aleatorios para poder repetir la prueba",
                  "var n = Date.now().toString().slice(-8);",
                  "pm.environment.set('emailAleatorio', 'cliente.prueba' + n + '@correo.com');",
                  "pm.environment.set('documentoAleatorio', '10' + n);"
                ]
