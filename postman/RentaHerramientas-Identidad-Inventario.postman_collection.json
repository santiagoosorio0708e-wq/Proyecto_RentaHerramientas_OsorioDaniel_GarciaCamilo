    {
      "name": "4. Inventario del proveedor",
      "item": [
        {
          "name": "Crear herramienta (PROVEEDOR)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('serieAleatoria', 'SN-TEST-' + Date.now().toString().slice(-8));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201 Created', function () { pm.response.to.have.status(201); });",
                  "",
                  "pm.test('Nace DISPONIBLE', function () {",
                  "    pm.expect(pm.response.json().data.estadoOperativo).to.eql('DISPONIBLE');",
                  "});",
                  "",
                  "pm.test('Se creo la tarifa DIARIA automaticamente', function () {",
                  "    var tarifas = pm.response.json().data.tarifas;",
                  "    var tiene = tarifas.some(function (t) { return t.tipoTarifa === 'DIARIA'; });",
                  "    pm.expect(tiene).to.eql(true);",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "if (json.data) { pm.environment.set('idHerramientaNueva', json.data.idHerramienta); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenProveedor}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
